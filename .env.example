# GHL Marketplace App — Agency OAuth token
GHL_AGENCY_TOKEN=your-agency-oauth-token

# Supabase — SUPABASE_URL is auto-injected in Edge Functions
# Set SUPABASE_SERVICE_ROLE_KEY as a secret via: supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Simple API key to authenticate injection script -> backend calls
API_SECRET=your-random-secret-here
