# GHL Marketplace App — Agency OAuth token
GHL_AGENCY_TOKEN=your-agency-oauth-token

# Supabase (use Service Role Key for backend — bypasses RLS)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Simple API key to authenticate injection script -> backend calls
API_SECRET=your-random-secret-here

# Port (Railway sets this automatically)
PORT=3000
