# GHL OAuth App (from Marketplace > My Apps)
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=

# Vercel KV (auto-populated when you link a KV store)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Simple API key to authenticate injection script -> backend calls
API_SECRET=your-random-secret-here

# Your Vercel deployment URL (no trailing slash)
APP_URL=https://your-app.vercel.app
