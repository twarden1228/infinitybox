# Agency-level Private Integration token from GHL
GHL_AGENCY_TOKEN=your-agency-token-here

# Agency company ID (find in GHL Agency Settings)
GHL_COMPANY_ID=your-company-id-here

# Secret key that clients must send in x-api-key header
API_SECRET_KEY=your-secret-key-here

# Server port (optional, defaults to 3000)
PORT=3000
